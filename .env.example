# API Configuration - Example Environment Variables
# Copy this file to .env.local and adjust values as needed

# Production environment flag
VITE_PRODUCTION=false

# Base URL for the backend API
VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_API_BASE_URL_PROD=https://apps.cayalti.com.pe:6061/server-cayalti/api

# API Endpoints
VITE_VALIDATE_USER_ENDPOINT=/personal-utilidades/buscar-colaborador
VITE_UPDATE_USER_ENDPOINT=/personal-utilidades/actualizar-colaborador

# Optional: API timeout in milliseconds
VITE_API_TIMEOUT=10000
